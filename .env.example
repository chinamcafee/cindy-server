CINDY_ENV=dev
CINDY_REGION=global
CINDY_HTTP_ADDR=:19828
CINDY_PUBLIC_BASE_URL=http://127.0.0.1:19828
CINDY_ADMIN_BASE_URL=http://127.0.0.1:15900

CINDY_DATABASE_URL=postgres://cindy:cindy_dev_password@127.0.0.1:5432/cindy?sslmode=disable
CINDY_REDIS_URL=redis://127.0.0.1:6379/0

CINDY_S3_ENDPOINT=http://127.0.0.1:9000
CINDY_S3_ACCESS_KEY=cindy
CINDY_S3_SECRET_KEY=cindy_dev_password
CINDY_S3_BUCKET_PUBLIC=cindy-public
CINDY_S3_BUCKET_PRIVATE=cindy-private
CINDY_S3_BUCKET_PLUGINS=cindy-plugins
CINDY_S3_BUCKET_SKILLS=cindy-skills
CINDY_S3_USE_SSL=false

CINDY_JWT_PRIVATE_KEY_FILE=./.keys/jwt-ed25519.pem
CINDY_ACCESS_TTL=15m
CINDY_REFRESH_TTL=720h
CINDY_MASTER_KEY=cindy_dev_master_key_change_me

CINDY_SMTP_ADDR=127.0.0.1:1025
CINDY_SMTP_FROM=no-reply@cindy.local
CINDY_SMTP_USERNAME=
CINDY_SMTP_PASSWORD=
CINDY_SMTP_TLS=auto
CINDY_SMTP_AUTH=auto

# Personal deployment: verified email and phone identities attach to one account.
CINDY_SINGLE_USER_MODE=false
CINDY_SINGLE_USER_ACCOUNT_ID=
# SMS dev fixed code (phone login). Leave empty in production.
CINDY_DEV_FIXED_CODE=
# Email dev fixed code. Keep empty when SMTP is configured so email codes are
# random and actually delivered; set e.g. 123456 only for offline debugging.
CINDY_EMAIL_DEV_FIXED_CODE=

# SMS: auto = Aliyun when all credentials are present, otherwise dev log sender.
# In production, unset CINDY_DEV_FIXED_CODE and configure Aliyun SMS.
# APNs push (optional). The key is the Auth Key .p8 downloaded from Apple.
CINDY_APNS_KEY_ID=
CINDY_APNS_TEAM_ID=
CINDY_APNS_PRIVATE_KEY_FILE=
CINDY_APNS_TOPIC_GLOBAL=
CINDY_APNS_TOPIC_CN=

CINDY_SMS_PROVIDER=auto
CINDY_ALIYUN_SMS_ACCESS_KEY_ID=
CINDY_ALIYUN_SMS_ACCESS_KEY_SECRET=
CINDY_ALIYUN_SMS_SIGN_NAME=
CINDY_ALIYUN_SMS_TEMPLATE_CODE=
CINDY_ALIYUN_SMS_REGION_ID=cn-hangzhou
CINDY_ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
CINDY_ALIYUN_SMS_TEMPLATE_PARAM=code

# Managed model inference gateway. Leave upstreams empty to keep /v1 disabled.
# CINDY_GATEWAY_API_KEY is the key clients receive from /api/model-access/credentials.
CINDY_GATEWAY_API_KEY=
CINDY_GATEWAY_OPENAI_BASE_URL=
CINDY_GATEWAY_OPENAI_API_KEY=
CINDY_GATEWAY_ANTHROPIC_BASE_URL=
CINDY_GATEWAY_ANTHROPIC_API_KEY=

# Voice dictation data plane. Empty websocket URL disables /api/voice/sessions.
CINDY_VOICE_ASR_WS_URL=
CINDY_VOICE_ASR_PROVIDER=qwen3-asr-flash-realtime
CINDY_VOICE_ASR_PROTOCOL_PROFILE=qwen-asr-server-vad
CINDY_VOICE_ASR_SAMPLE_RATE=16000
CINDY_VOICE_ASR_MODEL=
CINDY_VOICE_REFINER_ENABLED=false

CINDY_TURN_SECRET=cindy_turn_secret
CINDY_TURN_URLS=turn:127.0.0.1:3478?transport=udp

CINDY_ADMIN_BOOTSTRAP_EMAIL=admin@cindy.local
CINDY_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

CINDY_METRICS_ENABLED=true
